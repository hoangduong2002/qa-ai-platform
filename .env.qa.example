# QA Platform Phase 0-11 conservative rollout template.
# Authorization credentials belong in .env.secrets.

# Knowledge Base
KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_BASE_ROOT=knowledge_bases
KNOWLEDGE_BASE_MAX_FILE_SIZE_BYTES=2097152
KNOWLEDGE_BASE_DEFAULT_TOP_K=10

# Structured Requirement Analysis
STRUCTURED_ANALYSIS_ENABLED=true
STRUCTURED_ANALYSIS_SHADOW_MODE=false

# Requirement Quality Gate
REQUIREMENT_QUALITY_GATE_ENABLED=true
REQUIREMENT_QUALITY_GATE_MODE=warn
REQUIREMENT_QUALITY_LLM_REVIEW_ENABLED=false

# Knowledge Retrieval
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_RETRIEVAL_SHADOW_MODE=false

# Knowledge Reference Review
KNOWLEDGE_REFERENCE_REVIEW_REQUIRED=true
KNOWLEDGE_REFERENCE_REVIEWER_IDS=
KNOWLEDGE_REFERENCE_REVIEW_LLM_CONFLICT_ASSIST=false

# Controlled Requirement Enrichment
KB_ANALYSIS_ENRICHMENT_MODE=manual

# Coverage Model: off, shadow, enabled
COVERAGE_MODEL_MODE=shadow

# Test Case Generator: v1, v2-shadow, v2-manual, v2
TEST_CASE_GENERATOR_VERSION=v2-manual

# Independent Test Quality Review: off, warn, block_export
TEST_QUALITY_REVIEW_ENABLED=true
TEST_QUALITY_REVIEW_MODE=warn
TEST_QUALITY_REVIEW_AI_MODE=
TEST_QUALITY_REVIEW_MODEL=
TEST_QUALITY_CORRECTOR_AI_MODE=
TEST_QUALITY_CORRECTOR_MODEL=

# Traceability and Export Protection
TRACEABILITY_GATE_ENABLED=true
EXPORT_QUALITY_GATE_ENABLED=false
# Supported values: warn, block. Set EXPORT_QUALITY_GATE_ENABLED=false for off.
EXPORT_QUALITY_GATE_MODE=warn
EXPORT_GATE_BLOCK_UNRESOLVED_BLOCKERS=true
EXPORT_GATE_BLOCK_UNCOVERED_ACCEPTANCE_CRITERIA=true
EXPORT_GATE_BLOCK_UNCOVERED_MANDATORY_COVERAGE=true
EXPORT_GATE_BLOCK_UNSUPPORTED_EXPECTED_RESULTS=true
EXPORT_GATE_BLOCK_UNREVIEWED_CONFLICTS=true
EXPORT_GATE_BLOCK_MISSING_TRACEABILITY=true
EXPORT_GATE_BLOCK_MISSING_QA_APPROVAL=true
EXPORT_GATE_QA_LEAD_IDS=

# QA Feedback and Evaluation
QA_FEEDBACK_REVIEWER_IDS=
GOLDEN_DATASET_REVIEWER_IDS=
REQUIREMENT_ANALYZER_VERSION=structured-analysis-v1
KNOWLEDGE_RETRIEVAL_VERSION=retrieval-v1
KNOWLEDGE_RANKING_VERSION=ranking-v1
