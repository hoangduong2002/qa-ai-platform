# Non-secret AI provider and routing configuration template.
# Credentials belong in .env.secrets.
#
# Canonical modes accepted by the current routing implementation:
# TEST_LOCAL_ONLY, PRODUCTION_HYBRID_DEEPSEEK, PRODUCTION_HYBRID_COPILOT,
# DEEPSEEK_ONLY, COPILOT_ONLY, NO_LLM.

TELEGRAM_AI_MODE=PRODUCTION_HYBRID_DEEPSEEK
PORTAL_DEFAULT_AI_MODE=NO_LLM
NON_PORTAL_AI_MODE=
MAX_CLARIFICATIONS_PER_ROUND=5
MAX_CLARIFICATION_ROUNDS=3

DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=120
ALLOW_DEEPSEEK_PRO=false
FORCE_DISABLE_DEEPSEEK=false

COPILOT_BASE_URL=http://localhost:3100/v1/chat/completions
COPILOT_MODEL=claude-sonnet-4.6
COPILOT_TIMEOUT=180
FORCE_DISABLE_COPILOT=false

LOCAL_AI_PROVIDER=OLLAMA
LOCAL_BASE_URL=http://localhost:11434
LOCAL_TEXT_MODEL=qwen2.5:14b
LOCAL_COMPACT_MODEL=
LOCAL_VISION_MODEL=qwen2.5vl:7b
LOCAL_TEXT_TIMEOUT=180
LOCAL_COMPACT_TIMEOUT=180
LOCAL_VISION_TIMEOUT=240
FORCE_DISABLE_LOCAL_AI=false

MAX_CONCURRENT_LLM_CALLS=2
MAX_CONCURRENT_DEEPSEEK_CALLS=2
MAX_CONCURRENT_COPILOT_CALLS=2
MAX_CONCURRENT_LOCAL_CALLS=1
LLM_HEALTH_CHECK_TIMEOUT=30
LLM_CONCURRENCY_WAIT_TIMEOUT=300
LLM_CONCURRENCY_RETRY_COUNT=3
LLM_CONCURRENCY_RETRY_DELAY_SECONDS=10

MAX_DEEPSEEK_CALLS_PER_JOB=20
MAX_DEEPSEEK_INPUT_TOKENS_PER_JOB=300000
MAX_DEEPSEEK_OUTPUT_TOKENS_PER_JOB=100000
AI_DRY_RUN=false
AI_USAGE_LOG_PATH=runtime/ai_usage_logs.jsonl
