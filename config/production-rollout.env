# Phase 0-11 conservative production rollout profile.
# Copy values into the deployment environment; do not commit real secrets here.

KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_BASE_ROOT=knowledge_bases
KNOWLEDGE_BASE_MAINTAINER_TOKEN=<set-in-deployment-secret-store>

STRUCTURED_ANALYSIS_ENABLED=true
STRUCTURED_ANALYSIS_SHADOW_MODE=false

REQUIREMENT_QUALITY_GATE_ENABLED=true
REQUIREMENT_QUALITY_GATE_MODE=warn
REQUIREMENT_QUALITY_LLM_REVIEW_ENABLED=false

KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_RETRIEVAL_SHADOW_MODE=false
KNOWLEDGE_REFERENCE_REVIEW_REQUIRED=true
KNOWLEDGE_REFERENCE_REVIEWER_IDS=<comma-separated-reviewer-identities>
KNOWLEDGE_REFERENCE_REVIEW_LLM_CONFLICT_ASSIST=false

KB_ANALYSIS_ENRICHMENT_MODE=manual

# COVERAGE_MODEL_ENABLED=shadow remains accepted as a legacy alias.
COVERAGE_MODEL_MODE=shadow

TEST_CASE_GENERATOR_VERSION=v2-manual

TEST_QUALITY_REVIEW_ENABLED=true
TEST_QUALITY_REVIEW_MODE=warn

TRACEABILITY_GATE_ENABLED=true
EXPORT_QUALITY_GATE_ENABLED=false
EXPORT_QUALITY_GATE_MODE=warn
EXPORT_GATE_QA_LEAD_IDS=<comma-separated-qa-lead-identities>

QA_FEEDBACK_REVIEWER_IDS=<comma-separated-reviewer-identities>
GOLDEN_DATASET_REVIEWER_IDS=<comma-separated-qa-lead-identities>

